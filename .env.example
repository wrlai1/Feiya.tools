# Copy this file to .env and fill in your values
DATABASE_URL=postgresql://username:password@host/dbname?sslmode=require
JWT_SECRET=pick-any-long-random-string-here
# Used only when the users table is empty. Remove it after the first admin login.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=use-a-private-random-password-of-at-least-12-characters
# Daily inventory email (create an API key after verifying the sender domain in Resend)
RESEND_API_KEY=re_xxxxxxxxx
INVENTORY_EMAIL_FROM=Feiya Inventory <inventory@your-verified-domain.com>
# Vercel automatically sends this value to the scheduled endpoint as a bearer token
CRON_SECRET=use-a-long-random-string-here
